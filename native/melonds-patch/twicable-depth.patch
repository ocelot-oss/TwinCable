     Platform::Semaphore* Sema_ScanlineCount;
+
+    // twicable: the depth of the frame on screen, copied when its rendering is done (the next one starts at line 215,
+    // long before a frontend could read it)
+    bool TwicableOn = false;
+    bool TwicableValid = false;
+    bool TwicableWBuffer = false;
+    u32 TwicableBuf[256 * 192];
 };
