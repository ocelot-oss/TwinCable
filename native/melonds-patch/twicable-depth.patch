     virtual void DrawScanline(u32 line) = 0;
     virtual void DrawSprites(u32 line) = 0;
 
+    // twicable: the 3D renderer (Shared World reads the depth of the frame on screen from the software one)
+    Renderer3D* Twicable3D() noexcept { return Rend3D.get(); }
