diff --git a/src/GPU3D_Soft.cpp b/src/GPU3D_Soft.cpp
index e620270..9b1d560 100644
--- a/src/GPU3D_Soft.cpp
+++ b/src/GPU3D_Soft.cpp
@@ -1741,6 +1741,27 @@ void SoftRenderer3D::FinishRendering()
 {
     if (RenderThreadRunning.load(std::memory_order_relaxed) && !GPU3D.AbortFrame)
         Platform::Semaphore_Wait(Sema_RenderDone);
+
+    // twicable: the frame on screen is rendered (line 192) – keep its depth before line 215 starts the next one
+    if (TwicableOn)
+    {
+        for (int y = 0; y < 192; y++)
+            memcpy(&TwicableBuf[y * 256], &DepthBuffer[FirstPixelOffset + y * ScanlineWidth], 256 * sizeof(u32));
+        TwicableWBuffer = GPU3D.RenderNumPolygons > 0 && GPU3D.RenderPolygonRAM[0] && GPU3D.RenderPolygonRAM[0]->WBuffer;
+        TwicableValid = true;
+    }
+}
+
+int SoftRenderer3D::TwicableDepth(int x, int y, int w, int h, u32* out) const noexcept
+{
+    if (!TwicableValid || w <= 0 || h <= 0) return 0;
+    for (int r = 0; r < h; r++)
+        for (int c = 0; c < w; c++)
+        {
+            const int sx = x + c, sy = y + r;
+            out[r * w + c] = (sx < 0 || sy < 0 || sx >= 256 || sy >= 192) ? 0xFFFFFFFF : (TwicableBuf[sy * 256 + sx] & 0xFFFFFF);
+        }
+    return TwicableWBuffer ? 3 : 1;
 }
 
 void SoftRenderer3D::RenderFrame()
