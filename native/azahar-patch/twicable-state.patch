+namespace {
+/// twicable: an output stream straight into a vector (sized like the last state: no stringstream doubling its buffer,
+/// no copy out of it – the part of a save state the game waits for is copying its memory once).
+class VectorOut : public std::streambuf {
+public:
+    explicit VectorOut(std::vector<u8>& v) : v{v} {}
+
+protected:
+    std::streamsize xsputn(const char* s, std::streamsize n) override {
+        v.insert(v.end(), reinterpret_cast<const u8*>(s), reinterpret_cast<const u8*>(s) + n);
+        return n;
+    }
+    int_type overflow(int_type c) override {
+        if (!traits_type::eq_int_type(c, traits_type::eof()))
+            v.push_back(static_cast<u8>(traits_type::to_char_type(c)));
+        return traits_type::not_eof(c);
+    }
+
+private:
+    std::vector<u8>& v;
+};
+} // namespace
+
+std::function<std::vector<u8>()> System::SaveStateDeferred() const {
+    static std::size_t last = 0;
+    auto raw = std::make_shared<std::vector<u8>>();
+    raw->reserve(last ? last + last / 16 : std::size_t{320} << 20);
+    {
+        VectorOut buf{*raw};
+        std::ostream os{&buf};
+        oarchive oa{os};
+        oa&* this;
+    }
+    last = raw->size();
+    const u64 program_id = title_id;
+    return [raw, program_id]() {
+        auto buffer = Common::Compression::CompressDataZSTDDefault(
+            std::span<const u8>{raw->data(), raw->size()});
+        raw->clear();
+        raw->shrink_to_fit();
+        if (buffer.empty())
+            throw std::runtime_error("Could not compress the save state");
+
+        CSTHeader header{};
+        header.filetype = header_magic_bytes;
+        header.program_id = program_id;
+        std::string rev_bytes;
+        CryptoPP::StringSource ss(Common::g_scm_rev, true,
+                                  new CryptoPP::HexDecoder(new CryptoPP::StringSink(rev_bytes)));
+        std::memcpy(header.revision.data(), rev_bytes.data(), sizeof(header.revision));
+        header.time = std::chrono::duration_cast<std::chrono::seconds>(
+                          std::chrono::system_clock::now().time_since_epoch())
+                          .count();
+        const std::string build_fullname = Common::g_build_fullname;
+        std::memcpy(header.build_name.data(), build_fullname.c_str(),
+                    std::min(build_fullname.length(), sizeof(header.build_name) - 1));
+        const std::string build_version = Common::g_build_version;
+        std::memcpy(header.build_version.data(), build_version.c_str(),
+                    std::min(build_version.length(), sizeof(header.build_version) - 1));
+
+        std::vector<u8> result((u8*)&header, (u8*)&header + sizeof(header));
+        result.insert(result.end(), buffer.begin(), buffer.end());
+        return result;
+    };
+}
