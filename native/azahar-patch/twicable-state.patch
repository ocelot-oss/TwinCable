+// ---- twicable: a save state that stops the game only while it is copied ----------------------------------------------
+// retro_serialize_size packs the state between two frames – serializing ~300 MB of the 3DS' memory into a stringstream
+// and compressing it with zstd took 0.4 s on a Windows PC, a gap in the sound (no frames meanwhile) every time twicable's
+// play view saved its resume state (every 2 minutes). Here the game stops only while the state is copied into one buffer;
+// zstd and the header run on a thread of their own, and twicable collects the result a few frames later.
+namespace {
+struct TwicableStateJob {
+    std::mutex mx;
+    int status = 0; // 0 being packed, 1 ready, -1 failed
+    std::vector<u8> out;
+};
+std::shared_ptr<TwicableStateJob> twicable_state_job;
+} // namespace
+
+/// Starts a save state: 1 started, 0 the last one is still being packed, -1 failed (no game, the game's file / network
+/// operations didn't settle, or serializing failed). Call between two frames, from the thread that runs the core.
+RETRO_API int twicable_state_begin(void) {
+    if (twicable_state_job) {
+        std::lock_guard lock{twicable_state_job->mx};
+        if (twicable_state_job->status == 0)
+            return 0;
+    }
+    twicable_state_job.reset();
+    auto& system = Core::System::GetInstance();
+    if (!system.IsPoweredOn() || !DrainAsyncOperations(system))
+        return -1;
+    std::function<std::vector<u8>()> pack;
+    try {
+        pack = system.SaveStateDeferred();
+    } catch (const std::exception& e) {
+        LOG_ERROR(Frontend, "Error saving state: {}", e.what());
+        return -1;
+    }
+    auto job = std::make_shared<TwicableStateJob>();
+    const auto run = [job, pack]() {
+        std::vector<u8> r;
+        try {
+            r = pack();
+        } catch (const std::exception& e) {
+            LOG_ERROR(Frontend, "Error packing state: {}", e.what());
+        }
+        std::lock_guard lock{job->mx};
+        job->out = std::move(r);
+        job->status = job->out.empty() ? -1 : 1;
+    };
+    try {
+        std::thread(run).detach();
+    } catch (const std::exception&) {
+        run(); // (no thread to be had: pack it here)
+    }
+    twicable_state_job = job;
+    return 1;
+}
+
+/// The started save state's size once it is packed, 0 while it is still being packed, -1 failed or none started.
+RETRO_API int64_t twicable_state_poll(void) {
+    if (!twicable_state_job)
+        return -1;
+    std::lock_guard lock{twicable_state_job->mx};
+    if (twicable_state_job->status == 0)
+        return 0;
+    return twicable_state_job->status == 1 ? static_cast<int64_t>(twicable_state_job->out.size()) : -1;
+}
+
+/// Copies the packed save state into `out` (at least twicable_state_poll() bytes) and forgets it; false if it isn't ready.
+RETRO_API bool twicable_state_take(void* out, size_t size) {
+    if (!twicable_state_job || !out)
+        return false;
+    {
+        std::lock_guard lock{twicable_state_job->mx};
+        if (twicable_state_job->status != 1 || size < twicable_state_job->out.size())
+            return false;
+        std::memcpy(out, twicable_state_job->out.data(), twicable_state_job->out.size());
+    }
+    twicable_state_job.reset();
+    return true;
+}
+
 } // extern "C"
