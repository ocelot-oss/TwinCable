+StereoFrame16 Mixers::TwicableDownmix(const std::array<QuadFrame32, 3>& input) const {
+    StereoFrame16 out{};
+    for (std::size_t mix = 0; mix < 3; mix++) {
+        const QuadFrame32& samples =
+            mix > 0 && state.aux_bus_enable[mix - 1] ? state.intermediate_mix_buffer[mix] : input[mix];
+        const float gain = state.intermediate_mixer_volume[mix];
+        for (std::size_t i = 0; i < out.size(); i++) {
+            const auto& x = samples[i];
+            if (state.output_format == OutputFormat::Mono) {
+                const s16 mono = ClampToS16(
+                    static_cast<s32>((gain * x[0] + gain * x[1] + gain * x[2] + gain * x[3]) / 2));
+                out[i] = AddAndClampToS16(out[i], {mono, mono});
+            } else {
+                const s16 left = ClampToS16(static_cast<s32>(gain * x[0] + gain * x[2]));
+                const s16 right = ClampToS16(static_cast<s32>(gain * x[1] + gain * x[3]));
+                out[i] = AddAndClampToS16(out[i], {left, right});
+            }
+        }
+    }
+    return out;
+}
