+// ---- twicable: the game's sound without its streamed music (twicable's sound effects during fast-forward) ------------
+// common/twicable_music.h: twicable names the music streams in the RomFS, the core recognises the DSP voices that play
+// them and – while asked – leaves them out of the frame it hands to the audio callback (the game itself still hears
+// everything). twicable_audio_frame_flags tells, from inside the audio callback, what the frame just handed over is.
+
+/// The music streams of RomFS `tag` (as twicable_romfs_reads tags them): n [start, end) pairs, offsets in its level 3;
+/// n = 0 forgets them. Any time; takes effect for the reads that follow.
+RETRO_API void twicable_audio_music_ranges(uint32_t tag, const uint64_t* pairs, uint32_t n) {
+    TwicableMusic::SetRanges(tag, pairs, pairs ? n : 0);
+}
+
+/// 1: leave the music voices out of the frames that go to the audio callback (from the next frame on), 0: don't.
+RETRO_API void twicable_audio_mute_music(uint32_t on) {
+    TwicableMusic::S().mute.store(on != 0, std::memory_order_relaxed);
+}
+
+/// The frame just handed to the audio callback (call it from there): TwicableMusic::F_* bits – 1 a new sound that isn't
+/// music began, 2 music voices were left out, 4 asked but left in (unsure), 8 asked, 16 a music voice played.
+RETRO_API uint32_t twicable_audio_frame_flags(void) {
+    return TwicableMusic::S().flags.load(std::memory_order_relaxed);
+}
+
+/// Diagnostics into out[0..max): music voices (bit mask), fingerprints noted, buffers recognised, buffers not,
+/// AAC decodes recognised, RomFS with music streams, unsure (0/1). Returns how many were written.
+RETRO_API uint32_t twicable_audio_music_state(uint64_t* out, uint32_t max) {
+    auto& s = TwicableMusic::S();
+    uint64_t mask = 0;
+    for (uint32_t i = 0; i < TwicableMusic::SOURCES; i++)
+        if (s.voices[i].music)
+            mask |= 1ull << i;
+    std::size_t tags;
+    {
+        std::scoped_lock l(s.lock);
+        tags = s.tags.size();
+    }
+    const uint64_t v[] = {mask, s.noted.load(), s.hits.load(), s.misses.load(), s.decoded.load(), tags, s.unsure ? 1u : 0u};
+    uint32_t n = 0;
+    for (; out && n < max && n < sizeof v / sizeof *v; n++)
+        out[n] = v[n];
+    return n;
+}
+
 } // extern "C"
 
