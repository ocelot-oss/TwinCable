diff --git a/src/common/twicable_music.h b/src/common/twicable_music.h
new file mode 100644
index 0000000..17a3f6d
--- /dev/null
+++ b/src/common/twicable_music.h
@@ -0,0 +1,311 @@
+// twicable: which DSP voices play the game's streamed music – so that, while twicable fast-forwards, the core can hand out
+// the game's sound without its music (twicable then plays the music track itself at normal speed, from the ROM, and the
+// game's sound effects on top of it).
+//
+// How a voice is known to be music, without knowing the game: twicable tells the core where the music streams are in the
+// RomFS (SetRanges – the stream files it found by their own bytes, BCSTM / ADTS AAC). Every RomFS read the game makes
+// that touches one of them is fingerprinted (NoteRead: a 64-bit hash of 16 bytes at every 8-byte step of the file – the
+// DSP-ADPCM frames a voice can start at – and at every ADTS sync word). A DSP voice that starts a buffer whose first 16
+// bytes carry one of those fingerprints plays bytes of a music stream: music. X/Y's AAC goes through the DSP's AAC
+// decoder first: a decode whose source is a music stream's frame (fingerprint) marks its output (the PCM it writes, its
+// addresses and its own fingerprints) as music, and a voice playing that PCM is music. A voice keeps the mark while it
+// plays on (looping, queued buffers); a fresh buffer that doesn't match – a new sound on that voice – clears it.
+//
+// Nothing here changes what the game sees: the DSP's shared memory (source statuses, the final mix, the aux buses) is
+// written exactly as before; only the copy of the frame that goes out to the frontend leaves the music voices out, and
+// only while the frontend asks for it (SetMute) and nothing looks unsure (a voice that has been streaming queued buffers
+// for half a second without being recognised: then nothing is left out – the frontend sees that per frame in FrameFlags).
+// Header-only, so the file system (core) and the DSP (audio_core) share it without a new link dependency.
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <cstring>
+#include <memory>
+#include <mutex>
+#include <vector>
+
+namespace TwicableMusic {
+
+constexpr uint32_t SOURCES = 24;           // AudioCore::HLE::num_sources
+constexpr uint32_t TABLE_BITS = 17;        // fingerprints kept (2 MB): ~14 s of emulated stereo ADPCM, more for AAC
+constexpr uint32_t UNSURE_FRAMES = 100;     // ~0.5 s of DSP frames (160 samples at 32728 Hz): an unknown voice streaming
+                                            // queued buffers that long might be music nobody told the core about
+// FrameFlags bits (the frame that just went out through the frontend's audio callback)
+constexpr uint32_t F_ONSET = 1;   // a voice that isn't music started a new sound in this frame (key-on)
+constexpr uint32_t F_MUTED = 2;   // music voices were left out of this frame
+constexpr uint32_t F_UNSURE = 4;  // muting was asked for but left off: an unknown voice streams (see above)
+constexpr uint32_t F_ASKED = 8;   // muting was asked for (SetMute)
+constexpr uint32_t F_MUSIC = 16;  // a music voice played in this frame (muted or not)
+
+struct Voice {
+    bool music = false;
+    uint8_t misses = 0;
+    bool key_on = false;       // a new sound began (enable 0→1, a new embedded buffer) – judged after the frame's dequeue
+    bool from_queue = false;   // the buffer playing came from the queue (a stream's continuation)
+    uint32_t stream_frames = 0; // frames this voice has played queued buffers without a pause
+};
+
+struct State {
+    std::mutex lock; // table, ranges, regions (the RomFS may be read from another thread than the DSP's)
+    struct Ranges {
+        uint32_t tag;
+        std::vector<std::pair<uint64_t, uint64_t>> r; // sorted [start, end)
+    };
+    std::vector<Ranges> tags;
+    std::unique_ptr<uint64_t[]> keys, vals; // fingerprint → (insertion serial) – 0 = empty
+    uint64_t serial = 0;
+    struct Region {
+        uint32_t addr = 0, len = 0;
+    };
+    std::array<Region, 128> regions{}; // the DSP AAC decoder's music output (physical addresses)
+    uint32_t region_next = 0;
+    // the DSP thread only
+    std::array<Voice, SOURCES> voices{};
+    std::atomic<bool> mute{false};
+    std::atomic<uint32_t> flags{0};
+    bool unsure = false;
+    // diagnostics
+    std::atomic<uint64_t> noted{0}, hits{0}, misses{0}, decoded{0};
+};
+
+inline State& S() {
+    static State s;
+    return s;
+}
+
+inline uint64_t Hash16(const uint8_t* p) {
+    uint64_t a, b;
+    std::memcpy(&a, p, 8);
+    std::memcpy(&b, p + 8, 8);
+    uint64_t h = a * 0x9E3779B97F4A7C15ull ^ (b + 0x632BE59BD9B4E019ull);
+    h ^= h >> 31;
+    h *= 0xD6E8FEB86659FD93ull;
+    h ^= h >> 29;
+    return h | 1; // (never 0: 0 marks an empty slot)
+}
+
+/** Silence and other near-constant bytes say nothing about where they came from. */
+inline bool Flat(const uint8_t* p) {
+    uint8_t seen[16];
+    int n = 0;
+    for (int i = 0; i < 16 && n < 4; i++) {
+        bool dup = false;
+        for (int k = 0; k < n; k++)
+            dup |= seen[k] == p[i];
+        if (!dup)
+            seen[n++] = p[i];
+    }
+    return n < 4;
+}
+
+/** (lock held) */
+inline void Insert(State& s, uint64_t key) {
+    if (!s.keys) {
+        s.keys = std::make_unique<uint64_t[]>(1u << TABLE_BITS);
+        s.vals = std::make_unique<uint64_t[]>(1u << TABLE_BITS);
+    }
+    const uint32_t mask = (1u << TABLE_BITS) - 1;
+    uint32_t i = static_cast<uint32_t>(key) & mask, victim = i;
+    uint64_t oldest = ~0ull;
+    for (int probe = 0; probe < 8; probe++, i = (i + 1) & mask) {
+        if (s.keys[i] == key || !s.keys[i]) {
+            victim = i;
+            break;
+        }
+        if (s.vals[i] < oldest)
+            oldest = s.vals[i], victim = i;
+    }
+    s.keys[victim] = key;
+    s.vals[victim] = ++s.serial;
+    s.noted.fetch_add(1, std::memory_order_relaxed);
+}
+
+/** (lock held) */
+inline bool Has(const State& s, uint64_t key) {
+    if (!s.keys)
+        return false;
+    const uint32_t mask = (1u << TABLE_BITS) - 1;
+    uint32_t i = static_cast<uint32_t>(key) & mask;
+    for (int probe = 0; probe < 8; probe++, i = (i + 1) & mask) {
+        if (s.keys[i] == key)
+            return true;
+        if (!s.keys[i])
+            return false;
+    }
+    return false;
+}
+
+/** The music streams of RomFS `tag`: n [start, end) pairs (offsets in its level 3); n = 0 forgets them. */
+inline void SetRanges(uint32_t tag, const uint64_t* pairs, uint32_t n) {
+    State& s = S();
+    std::scoped_lock l(s.lock);
+    auto it = std::find_if(s.tags.begin(), s.tags.end(), [&](const State::Ranges& r) { return r.tag == tag; });
+    if (!n) {
+        if (it != s.tags.end())
+            s.tags.erase(it);
+        return;
+    }
+    if (it == s.tags.end()) {
+        if (s.tags.size() >= 8)
+            s.tags.erase(s.tags.begin());
+        s.tags.push_back({tag, {}});
+        it = s.tags.end() - 1;
+    }
+    it->r.clear();
+    for (uint32_t i = 0; i < n; i++)
+        if (pairs[2 * i + 1] > pairs[2 * i])
+            it->r.emplace_back(pairs[2 * i], pairs[2 * i + 1]);
+    std::sort(it->r.begin(), it->r.end());
+}
+
+/** A read of the game: bytes [offset, offset + len) of RomFS `tag` – fingerprinted where they belong to a music stream. */
+inline void NoteRead(uint32_t tag, uint64_t offset, const uint8_t* data, std::size_t len) {
+    State& s = S();
+    if (!data || len < 16)
+        return;
+    std::scoped_lock l(s.lock);
+    const auto it = std::find_if(s.tags.begin(), s.tags.end(), [&](const State::Ranges& r) { return r.tag == tag; });
+    if (it == s.tags.end())
+        return;
+    const uint64_t end = offset + len;
+    // the streams this read touches (sorted, non-overlapping files)
+    auto r = std::upper_bound(it->r.begin(), it->r.end(), std::pair<uint64_t, uint64_t>{offset, ~uint64_t{0}});
+    if (r != it->r.begin())
+        --r;
+    for (; r != it->r.end() && r->first < end; ++r) {
+        const uint64_t a = std::max(offset, r->first), b = std::min(end, r->second);
+        if (b < a + 16)
+            continue;
+        // every 8 bytes from the file's start (DSP-ADPCM frames, PCM16 pairs)
+        for (uint64_t p = a + ((r->first - a) & 7); p + 16 <= b; p += 8) {
+            const uint8_t* q = data + (p - offset);
+            if (!Flat(q))
+                Insert(s, Hash16(q));
+        }
+        // ADTS frames (X/Y's AAC): wherever a sync word starts
+        for (uint64_t p = a; p + 16 <= b; p++) {
+            const uint8_t* q = data + (p - offset);
+            if (q[0] == 0xFF && (q[1] & 0xF6) == 0xF0 && ((p - r->first) & 7))
+                Insert(s, Hash16(q));
+        }
+    }
+}
+
+/** 1: these bytes are a music stream's (or the AAC decoder's music output), 0: they aren't, -1: can't tell (silence). */
+inline int Lookup(const uint8_t* p) {
+    if (!p)
+        return -1;
+    if (Flat(p))
+        return -1;
+    State& s = S();
+    std::scoped_lock l(s.lock);
+    return Has(s, Hash16(p)) ? 1 : 0;
+}
+
+/** The DSP's AAC decoder: if `src` is a music stream's frame, what it wrote to dst0 / dst1 (bytes each) is music. */
+inline void NoteDecoded(const uint8_t* src, uint32_t src_len, uint32_t dst0, const uint8_t* out0, uint32_t dst1,
+                        const uint8_t* out1, uint32_t bytes) {
+    if (!src || src_len < 16 || !bytes || Lookup(src) != 1)
+        return;
+    State& s = S();
+    std::scoped_lock l(s.lock);
+    s.decoded.fetch_add(1, std::memory_order_relaxed);
+    const uint32_t dst[2] = {dst0, dst1};
+    const uint8_t* out[2] = {out0, out1};
+    for (int c = 0; c < 2; c++) {
+        if (!dst[c] || !out[c])
+            continue;
+        s.regions[s.region_next++ % s.regions.size()] = {dst[c], bytes};
+        for (uint32_t p = 0; p + 16 <= bytes; p += 8)
+            if (!Flat(out[c] + p))
+                Insert(s, Hash16(out[c] + p));
+    }
+}
+
+/** Does [addr, addr + len) (physical) overlap the AAC decoder's recent music output? */
+inline bool InDecoded(uint32_t addr, uint32_t len) {
+    State& s = S();
+    std::scoped_lock l(s.lock);
+    for (const auto& r : s.regions)
+        if (r.len && addr < r.addr + r.len && r.addr < addr + len)
+            return true;
+    return false;
+}
+
+// ---- the DSP side (its thread only) ---------------------------------------------------------------------------------
+
+/** Source `id` begins a buffer (DequeueBuffer): `p` its first bytes (nullptr: unreadable), `bytes` how many it has. */
+inline void OnBuffer(uint32_t id, const uint8_t* p, uint32_t bytes, uint32_t paddr, bool from_queue, bool repeat) {
+    if (id >= SOURCES)
+        return;
+    State& s = S();
+    Voice& v = s.voices[id];
+    v.from_queue = from_queue;
+    if (repeat)
+        return; // a looping buffer again: whatever it was, it still is
+    int m = bytes >= 16 ? Lookup(p) : -1;
+    if (m != 1 && bytes && InDecoded(paddr, bytes))
+        m = 1;
+    if (m == 1) {
+        v.music = true;
+        v.misses = 0;
+        s.hits.fetch_add(1, std::memory_order_relaxed);
+    } else if (m == 0) {
+        s.misses.fetch_add(1, std::memory_order_relaxed);
+        // a fresh sound (not the queue's next part) that isn't music: the voice now plays something else; a stream's
+        // next part that doesn't match twice in a row: the same
+        if (!from_queue || ++v.misses >= 2) {
+            v.music = false;
+            v.misses = 0;
+        }
+    }
+}
+
+/** A DSP frame begins: leave the music out of it? (`asked`: the frontend asks – the frame's flags say so) */
+inline bool BeginFrame(bool& asked) {
+    State& s = S();
+    asked = s.mute.load(std::memory_order_relaxed);
+    return asked && !s.unsure;
+}
+
+/** Source `id` was ticked in this frame (`on`: enabled). Returns whether it plays music; `onset` set when it began a
+ *  new sound that isn't music. */
+inline bool VoiceFrame(uint32_t id, bool on, bool& onset) {
+    if (id >= SOURCES)
+        return false;
+    Voice& v = S().voices[id];
+    if (v.key_on) {
+        v.key_on = false;
+        onset |= on && !v.music;
+    }
+    v.stream_frames = on && v.from_queue ? v.stream_frames + 1 : 0;
+    return on && v.music;
+}
+
+/** The frame is mixed: its flags (for FrameFlags), and whether an unknown voice streams for long (the next frames). */
+inline uint32_t EndFrame(bool asked, bool muted, bool music, bool onset) {
+    State& s = S();
+    bool unsure = false;
+    for (const auto& v : s.voices)
+        unsure |= !v.music && v.stream_frames > UNSURE_FRAMES;
+    s.unsure = unsure;
+    const uint32_t f = (onset ? F_ONSET : 0) | (muted ? F_MUTED : 0) | (asked && unsure ? F_UNSURE : 0) |
+                       (asked ? F_ASKED : 0) | (music ? F_MUSIC : 0);
+    s.flags.store(f, std::memory_order_relaxed);
+    return f;
+}
+
+inline void OnKeyOn(uint32_t id) {
+    if (id < SOURCES)
+        S().voices[id].key_on = true;
+}
+
+inline void OnReset(uint32_t id) {
+    if (id < SOURCES)
+        S().voices[id] = {};
+}
+
+} // namespace TwicableMusic
