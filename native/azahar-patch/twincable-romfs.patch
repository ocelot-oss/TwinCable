+extern "C" {
+
+// ---- twincable: the game's RomFS reads (twincable's "music from the ROM") ---------------------------------------------
+// Every read the game makes from a RomFS (core/file_sys/ivfc_archive.cpp, IVFCFile::Read) is noted in a small
+// lock-free ring; twincable drains it between frames to see which music stream the game reads and how far it got. The
+// RomFS itself (its tables, the stream's header and data) is read through the same reader the game reads – the game's
+// own RomFS, its update's, a LayeredFS mod's – so what twincable finds is what the game plays.
+
+/// Up to `max` reads since the last call into `out`, 3 × u64 each: serial (0, 1, 2 …; a gap = reads lost because
+/// nobody drained them in time), offset (from the start of the RomFS' level 3), length | tag << 32 (which RomFS). The
+/// number of reads is returned. Any thread may read the RomFS meanwhile; call this from one thread only.
+RETRO_API uint32_t twincable_romfs_reads(uint64_t* out, uint32_t max) {
+    if (!out || !max)
+        return 0;
+    FileSys::TwinCable::RomFSRead tmp[64];
+    uint32_t n = 0;
+    while (n < max) {
+        const uint32_t got = FileSys::TwinCable::DrainReads(tmp, std::min<uint32_t>(64, max - n));
+        for (uint32_t i = 0; i < got; i++) {
+            out[3 * (n + i)] = tmp[i].serial;
+            out[3 * (n + i) + 1] = tmp[i].offset;
+            out[3 * (n + i) + 2] = static_cast<uint64_t>(tmp[i].length) | (static_cast<uint64_t>(tmp[i].tag) << 32);
+        }
+        n += got;
+        if (got < 64)
+            break;
+    }
+    return n;
+}
+
+/// Reads `size` bytes of the RomFS `tag` at `offset` (its level 3) into `out` – between two retro_run()s. Returns the
+/// bytes read: 0 when that RomFS is gone, fewer at its end. Not noted as a read of the game.
+RETRO_API uint32_t twincable_romfs_read(uint32_t tag, uint64_t offset, void* out, uint32_t size) {
+    if (!emu_instance || !emu_instance->game_loaded || !out || !size)
+        return 0;
+    return FileSys::TwinCable::ReadRomFS(tag, offset, static_cast<uint8_t*>(out), size);
+}
+
+/// The size of the RomFS `tag` (its level 3), 0 when it is gone.
+RETRO_API uint64_t twincable_romfs_size(uint32_t tag) {
+    if (!emu_instance || !emu_instance->game_loaded)
+        return 0;
+    return FileSys::TwinCable::RomFSSize(tag);
+}
+
+} // extern "C"
+
