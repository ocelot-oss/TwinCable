 namespace FileSys {
 
+// ---- twincable: the game's RomFS reads ------------------------------------------------------------------------------
+namespace TwinCable {
+namespace {
+TwinCableRomfs::Ring<256> ring;
+// The readers seen so far, by their control block (owner_before: an expired weak_ptr still holds it, so a new reader
+// can never be taken for an old one). A few live at a time – the game's RomFS, its update's, system archives.
+struct Known {
+    std::weak_ptr<RomFSReader> reader;
+    u32 tag = 0;
+};
+constexpr std::size_t KNOWN = 16;
+std::mutex known_lock;
+Known known[KNOWN];
+u32 next_tag = 1;
+thread_local bool own_read = false; // ReadRomFS's own reads aren't the game's
+
+u32 TagOf(const std::shared_ptr<RomFSReader>& r) {
+    std::scoped_lock lock(known_lock);
+    Known* free_slot = nullptr;
+    for (auto& k : known) {
+        if (k.tag && !k.reader.owner_before(r) && !r.owner_before(k.reader))
+            return k.tag;
+        if (!free_slot && (!k.tag || k.reader.expired()))
+            free_slot = &k;
+    }
+    if (!free_slot)
+        free_slot = &known[next_tag % KNOWN]; // (more than KNOWN live readers: the oldest tag goes)
+    free_slot->reader = r;
+    free_slot->tag = next_tag++;
+    return free_slot->tag;
+}
+
+std::shared_ptr<RomFSReader> ReaderOf(u32 tag) {
+    std::scoped_lock lock(known_lock);
+    for (auto& k : known)
+        if (tag && k.tag == tag)
+            return k.reader.lock();
+    return nullptr;
+}
+
+void Note(const std::shared_ptr<RomFSReader>& r, u64 offset, std::size_t length) {
+    if (own_read || !r || !length)
+        return;
+    ring.Push(offset, static_cast<u32>(std::min<std::size_t>(length, 0xFFFFFFFFu)), TagOf(r));
+}
+} // namespace
+
+u32 DrainReads(RomFSRead* out, u32 max) {
+    TwinCableRomfs::Read tmp[64];
+    u32 n = 0;
+    while (n < max) {
+        const u32 got = ring.Drain(tmp, std::min<u32>(64, max - n));
+        for (u32 i = 0; i < got; i++)
+            out[n + i] = {tmp[i].serial, tmp[i].offset, tmp[i].length, tmp[i].tag};
+        n += got;
+        if (got < 64)
+            break;
+    }
+    return n;
+}
+
+u64 RomFSSize(u32 tag) {
+    const auto r = ReaderOf(tag);
+    return r ? r->GetSize() : 0;
+}
+
+u32 ReadRomFS(u32 tag, u64 offset, u8* buffer, u32 length) {
+    const auto r = ReaderOf(tag);
+    if (!r || !buffer || !length)
+        return 0;
+    const u64 size = r->GetSize();
+    if (offset >= size)
+        return 0;
+    length = static_cast<u32>(std::min<u64>(length, size - offset));
+    own_read = true;
+    const std::size_t got = r->ReadFile(static_cast<std::size_t>(offset), length, buffer);
+    own_read = false;
+    return static_cast<u32>(std::min<std::size_t>(got, length));
+}
+} // namespace TwinCable
