diff --git a/src/core/file_sys/twincable_romfs_ring.h b/src/core/file_sys/twincable_romfs_ring.h
new file mode 100644
index 0000000..05109f7
--- /dev/null
+++ b/src/core/file_sys/twincable_romfs_ring.h
@@ -0,0 +1,87 @@
+// twincable: a log of the game's RomFS reads (offset, length, which RomFS) for twincable's "music from the ROM" – the
+// host drains it between frames and tells twincable which stream file the game reads and how far it got.
+//
+// Bounded, lock-free, many writers / one reader. A writer takes the next serial (one fetch_add) and fills its slot
+// under a per-slot sequence number (odd while it writes, even when done – a seqlock); the reader takes slots in serial
+// order and checks the sequence before and after copying. When the reader falls more than N reads behind, the oldest
+// are overwritten: the reader skips them (the serials it hands out show the gap). Writers never wait and never take a
+// lock – a read of the game costs a few atomic operations more, nothing that touches emulation or its timing.
+// Header-only and free of Azahar's own types: test/rommusic.test.mjs compiles it on its own.
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+namespace TwinCableRomfs {
+
+struct Read {
+    uint64_t serial; // 0, 1, 2 … in the order the reads came (a gap: reads that were overwritten before draining)
+    uint64_t offset; // from the start of the RomFS' level 3 (where the game's own RomFS tables begin)
+    uint32_t length;
+    uint32_t tag; // which RomFS (1, 2 … per reader in the order they were first read)
+};
+
+template <uint32_t N = 256>
+class Ring {
+    static_assert(N && (N & (N - 1)) == 0, "N must be a power of two");
+
+    struct Slot {
+        std::atomic<uint64_t> seq{0}; // 2·serial + 1 while written, 2·serial + 2 once complete
+        std::atomic<uint64_t> offset{0};
+        std::atomic<uint32_t> length{0};
+        std::atomic<uint32_t> tag{0};
+    };
+    Slot slots[N];
+    std::atomic<uint64_t> head{0}; // the next serial a writer takes
+    uint64_t tail = 0;             // the next serial the reader wants (reader only)
+
+public:
+    /// Any thread: note one read.
+    void Push(uint64_t offset, uint32_t length, uint32_t tag) {
+        const uint64_t s = head.fetch_add(1, std::memory_order_relaxed);
+        Slot& x = slots[s & (N - 1)];
+        x.seq.store(2 * s + 1, std::memory_order_relaxed);
+        std::atomic_thread_fence(std::memory_order_release);
+        x.offset.store(offset, std::memory_order_relaxed);
+        x.length.store(length, std::memory_order_relaxed);
+        x.tag.store(tag, std::memory_order_relaxed);
+        x.seq.store(2 * s + 2, std::memory_order_release);
+    }
+
+    /// The reader (one thread): up to `max` reads in serial order into `out`, the number returned. Stops at a read
+    /// still being written (it comes with the next drain).
+    uint32_t Drain(Read* out, uint32_t max) {
+        uint32_t n = 0;
+        const uint64_t end = head.load(std::memory_order_acquire);
+        if (end - tail > N)
+            tail = end - N; // overwritten before we got here
+        while (n < max && tail < end) {
+            const uint64_t s = tail;
+            Slot& x = slots[s & (N - 1)];
+            const uint64_t a = x.seq.load(std::memory_order_acquire);
+            if (a < 2 * s + 2)
+                break; // its writer isn't done yet (or hasn't started)
+            if (a > 2 * s + 2) {
+                tail++; // a newer read took the slot: this one is lost
+                continue;
+            }
+            Read r{s, x.offset.load(std::memory_order_relaxed), x.length.load(std::memory_order_relaxed),
+                   x.tag.load(std::memory_order_relaxed)};
+            std::atomic_thread_fence(std::memory_order_acquire);
+            if (x.seq.load(std::memory_order_relaxed) != a) {
+                tail++; // overwritten while we copied it
+                continue;
+            }
+            out[n++] = r;
+            tail++;
+        }
+        return n;
+    }
+
+    /// Reads ever noted (diagnostics).
+    uint64_t Count() const {
+        return head.load(std::memory_order_relaxed);
+    }
+};
+
+} // namespace TwinCableRomfs
