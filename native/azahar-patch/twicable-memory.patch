diff --git a/src/citra_libretro/citra_libretro.cpp b/src/citra_libretro/citra_libretro.cpp
index 8a65f9d..a070477 100644
--- a/src/citra_libretro/citra_libretro.cpp
+++ b/src/citra_libretro/citra_libretro.cpp
@@ -750,3 +750,75 @@ size_t retro_get_memory_size(unsigned id) {
 void retro_cheat_reset() {}
 
 void retro_cheat_set(unsigned index, bool enabled, const char* code) {}
+
+// ---- twicable: reading (and for cheats writing) the running game's memory --------------------------------------
+// The memory map (RETRO_ENVIRONMENT_SET_MEMORY_MAPS) is set once, when the game loads – before the game allocates
+// its heaps, so the regions frontends need for live data (the party in the application / linear heap) aren't in it.
+// These calls go through the process's page table instead: any mapped address, whatever VMAs it is split into.
+// Call them between two retro_run()s (the same thread), never from another thread.
+// RETRO_API: exported like the retro_* calls (a Windows DLL exports only what is marked, Linux builds may hide the
+// rest); macOS lists them in libretro.osx.def.
+extern "C" {
+
+/// Copies `size` bytes at the game process's virtual address `addr` to `out`. false when any byte isn't mapped
+/// (nothing is copied then) or no game runs.
+RETRO_API bool twicable_read_memory(uint32_t addr, void* out, uint32_t size) {
+    if (!emu_instance || !emu_instance->game_loaded || !out || size == 0)
+        return false;
+    auto& system = Core::System::GetInstance();
+    if (!system.IsPoweredOn())
+        return false;
+    auto process = system.Kernel().GetCurrentProcess();
+    if (!process)
+        return false;
+    auto& memory = system.Memory();
+    // every page of the range must be mapped (ReadBlock would log and zero-fill unmapped ones)
+    for (uint64_t page = addr & ~0xFFFull; page < static_cast<uint64_t>(addr) + size; page += 0x1000) {
+        if (!memory.IsValidVirtualAddress(*process, static_cast<VAddr>(page)))
+            return false;
+    }
+    memory.ReadBlock(*process, addr, out, size);
+    return true;
+}
+
+/// Writes `size` bytes from `data` to the game process's virtual address `addr` (twicable's cheats: a few bytes of the
+/// bag). Through the core's own memory system – the process's page table and Memory::WriteBlock – so the bytes land in
+/// the emulated memory on every OS, whatever the heap, and whatever the renderer cached there is invalidated. Only
+/// inside the game's heaps (application heap, linear heap, New 3DS linear heap), only within one 4 KB page, and only
+/// when that page is mapped: false otherwise, or when no game runs (nothing is written then).
+RETRO_API bool twicable_write_memory(uint32_t addr, const void* data, uint32_t size) {
+    if (!emu_instance || !emu_instance->game_loaded || !data || size == 0)
+        return false;
+    const uint64_t end = static_cast<uint64_t>(addr) + size;
+    if ((addr & 0xFFF) + static_cast<uint64_t>(size) > 0x1000)
+        return false;
+    const auto inside = [&](uint64_t lo, uint64_t hi) { return addr >= lo && end <= hi; };
+    if (!inside(Memory::HEAP_VADDR, Memory::HEAP_VADDR_END) &&
+        !inside(Memory::LINEAR_HEAP_VADDR, Memory::LINEAR_HEAP_VADDR_END) &&
+        !inside(Memory::NEW_LINEAR_HEAP_VADDR, Memory::NEW_LINEAR_HEAP_VADDR_END))
+        return false;
+    auto& system = Core::System::GetInstance();
+    if (!system.IsPoweredOn())
+        return false;
+    auto process = system.Kernel().GetCurrentProcess();
+    if (!process)
+        return false;
+    auto& memory = system.Memory();
+    if (!memory.IsValidVirtualAddress(*process, static_cast<VAddr>(addr)))
+        return false;
+    memory.WriteBlock(*process, addr, data, size);
+    return true;
+}
+
+/// The program (title) ID of the running process, 0 when none runs.
+RETRO_API uint64_t twicable_title_id(void) {
+    if (!emu_instance || !emu_instance->game_loaded)
+        return 0;
+    auto& system = Core::System::GetInstance();
+    if (!system.IsPoweredOn())
+        return 0;
+    auto process = system.Kernel().GetCurrentProcess();
+    return process && process->codeset ? process->codeset->program_id : 0;
+}
+
+} // extern "C"
